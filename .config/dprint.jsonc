{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "oxc": {
    "sortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  // The C API's headers, in the style maplibre-native-ffi formatted them with.
  "clangFormat": {
    "BasedOnStyle": "Google",
    "ColumnLimit": 80,
    "IndentWidth": 2,
    "ContinuationIndentWidth": 2,
    "UseCRLF": false,
    "UseTab": "Never",
    "AlignAfterOpenBracket": "BlockIndent",
    "IncludeBlocks": "Regroup",
    "IncludeCategories": [
      { "Regex": "^<[a-zA-Z0-9_]+>$", "Priority": -100 },
      { "Regex": "^<.*>$", "Priority": -50 },
      { "Regex": ".*", "Priority": 1 },
    ],
  },
  // Rust: the nightly rustfmt that .config/mise/config.toml's MLN_NIGHTLY
  // names, with its unstable import options; rustfmt.toml has the rest. Bump
  // the two together.
  "exec": {
    "commands": [
      {
        "cacheKeyFiles": ["rustfmt.toml"],
        "command": "rustfmt +nightly-2026-11-04 --config imports_granularity=Module,group_imports=StdExternalCrate",
        "exts": ["rs"],
      },
    ],
  },
  // Relative to this file, in .config/.
  "excludes": [
    // Generated code stays as its generator writes it, and the changelog as
    // release-plz writes it (release-plz.toml).
    "../CHANGELOG.md",
    // The fixtures' manifest, whose hash names the directory they install in.
    "../tools/bench/fixtures.json",
    "../crates/mln_c/src/generated/**",
    "../crates/mln_style/src/layers/*_layer_properties.rs",
    "../crates/mln_style/src/light_properties.rs",
    "../crates/mln_style/src/sky_properties.rs",
    "../crates/mln_engine/src/text/arabic_tables.rs",
    "../crates/mln_engine/src/text/bidi_mirroring.rs",
    "../examples/web/pnpm-lock.yaml",
    // Copies of other projects' files, kept as they are there.
    "**/testdata/**",
    "../patches/**",
    "../tools/style-codegen/v8.json",
  ],
  "plugins": [
    "npm:@dprint/clang-format@0.2.1",
    "npm:@dprint/oxc@0.50.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
  ],
}
