#!/usr/bin/env bash
#MISE description="Run the desktop demo app"
#USAGE flag "--profile <profile>" default="dev-opt" help="The Cargo profile: dev-opt for development, dev for unoptimized debugging, release for shipping optimizations"
#USAGE arg "[args]..." var=#true help="Arguments to the app"
set -euo pipefail
source tools/dev-shell.sh
eval "set -- ${usage_args:-}"
dev_shell cargo run --profile "$usage_profile" -p mln-rs-desktop --bin mln-desktop -- "$@"
