#!/usr/bin/env bash
#MISE description="Lint the Rust code with clippy"
# On Linux, also lint the C library with each native backend's feature alone,
# as maplibre-native-ffi's presets build it: the workspace's build turns them
# all on. Then check that the libraries, built alone with their default
# features, leave out wgpu: natively it is a feature for hosts to turn on.
set -euo pipefail
cargo clippy --workspace --all-targets "$@"
if [[ "$(uname -s)" == Linux ]]; then
    for backend in vulkan gl; do
        cargo clippy -p mln-rs-c --all-targets --no-default-features --features "$backend" "$@"
    done
fi
for package in mln-rs mln-rs-c; do
    if cargo tree -p "$package" --edges normal --prefix none | grep -Eq '^(mln-rs-webgpu|wgpu) '; then
        echo "error: $package's default build has wgpu" >&2
        exit 1
    fi
done
