#!/usr/bin/env bash
#MISE description="Build the tests into a test package for AWS Device Farm's phones (tools/device-farm)"
#USAGE arg "<platform>" help="The phones' platform" {
#USAGE   choices "android" "ios"
#USAGE }
#USAGE flag "--out <dir>" help="Where to write the package (default: target/device-farm/<platform>)"
# Android's in the target-android environment, `mise -E target-android run
# device-farm:package android`, and iOS's on a Mac with Xcode.
# tools/device-farm/README.md lists what the package holds: tests.zip, and
# for iOS the app, app.ipa.
set -euo pipefail
source tools/dev-shell.sh

platform=$usage_platform
out=${usage_out:-target/device-farm/$platform}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
package=$work/package
mkdir -p "$package" "$out"
rm -f "$out/tests.zip" "$out/app.ipa"

packages=()
while IFS= read -r name; do
    packages+=(-p "$name")
done < <(tools/ci/target-packages.sh)

case $platform in
    android)
        if [[ -z ${CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER:-} ]]; then
            echo "Select the target-android environment: mise -E target-android run device-farm:package android" >&2
            exit 1
        fi
        mkdir "$package/bin"
        rustup target add aarch64-linux-android
        dev_shell cargo nextest archive --target aarch64-linux-android "${packages[@]}" --archive-file "$package/tests.tar.zst"

        # The test host, for the phones' ABI.
        tools/android-test-host/build.sh arm64-v8a "$package/host"

        git ls-files -z --cached --others --exclude-standard | tar --null --files-from - -czf "$package/workspace.tar.gz"

        # The Linux x64 cargo-nextest and devices-cli pinned by mise, for Device
        # Farm's Amazon Linux 2023 test host.
        read -r nextest_url nextest_checksum devices_cli_version < <(
            python3 - << 'PYEOF'
import tomllib

with open(".config/mise/mise.lock", "rb") as f:
    nextest = tomllib.load(f)["tools"]["github:nextest-rs/nextest"][0]["platforms.linux-x64"]
with open(".config/mise/config.target-android.toml", "rb") as f:
    devices_cli = tomllib.load(f)["tools"]["go:github.com/sargunv/devices-cli"]
print(nextest["url"], nextest["checksum"].removeprefix("sha256:"), devices_cli)
PYEOF
        )
        curl --fail --silent --show-error --location --output "$work/nextest.tar.gz" "$nextest_url"
        echo "$nextest_checksum  $work/nextest.tar.gz" | shasum -a 256 --check --quiet
        tar -xzf "$work/nextest.tar.gz" -C "$package/bin"

        # Static Linux x64 binary so it runs on Amazon Linux 2023 regardless of the
        # host OS or glibc version.
        gomodcache=$(go env GOMODCACHE)
        CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOPATH="$work/go" GOMODCACHE="$gomodcache" GOBIN="" \
            go install -ldflags='-s -w' "github.com/sargunv/devices-cli@$devices_cli_version"
        devices_cli_bin=$work/go/bin/linux_amd64/devices-cli
        [[ -f $devices_cli_bin ]] || devices_cli_bin=$work/go/bin/devices-cli
        cp "$devices_cli_bin" "$package/bin/devices-cli"

        cp tools/device-farm/android/run-tests.sh "$package/"
        ;;
    ios)
        if ! xcrun --sdk iphoneos --show-sdk-path > /dev/null; then
            echo "Building for iOS needs Xcode" >&2
            exit 1
        fi
        rustup target add aarch64-apple-ios
        # The tests as dylibs that export only their main, which the test host
        # loads into the app's process and calls (tools/ios-test-host), and
        # without the debug map, whose object files stay on this machine.
        CARGO_TARGET_AARCH64_APPLE_IOS_RUSTFLAGS="-C link-arg=-dynamiclib -C link-arg=-Wl,-exported_symbol,_main -C strip=debuginfo" \
            cargo nextest list --list-type binaries-only --message-format json \
            --target aarch64-apple-ios "${packages[@]}" > "$work/binaries.json"
        cargo metadata --no-deps --format-version 1 --locked > "$work/metadata.json"

        app=$work/Payload/MlnRsTestHost.app
        tools/ios-test-host/build.sh "$app"
        mkdir "$app/Frameworks" "$app/workspace"
        git ls-files -z --cached --others --exclude-standard | tar --null --files-from - -cf - | tar -xf - -C "$app/workspace"

        # The binaries go to the app's Frameworks, and tests.json lists them for
        # run-tests.py: their nextest IDs, and their packages and the packages'
        # directories in the workspace.
        python3 - "$work" "$app" "$package/tests.json" << 'PYEOF'
import json
import pathlib
import plistlib
import shutil
import sys

work, app, listing = map(pathlib.Path, sys.argv[1:])
metadata = json.loads((work / "metadata.json").read_text())
root = pathlib.Path(metadata["workspace_root"])
packages = {package["id"]: package for package in metadata["packages"]}
binaries = []
for binary in json.loads((work / "binaries.json").read_text())["rust-binaries"].values():
    # Not proc-macros' tests, which are built for the host.
    if binary["build-platform"] != "target":
        continue
    path = pathlib.Path(binary["binary-path"])
    # MH_DYLIB, unless RUSTFLAGS overrode the target's rustflags.
    with path.open("rb") as file:
        if file.read(16)[12:] != (6).to_bytes(4, "little"):
            sys.exit(f"{path} isn't a dylib: is RUSTFLAGS set?")
    shutil.copy(path, app / "Frameworks" / f"{path.name}.dylib")
    package = packages[binary["package-id"]]
    binaries.append({
        "id": binary["binary-id"],
        "file": f"{path.name}.dylib",
        "package": package["name"],
        "dir": str(pathlib.Path(package["manifest_path"]).parent.relative_to(root)),
    })
bundle = plistlib.loads((app / "Info.plist").read_bytes())["CFBundleIdentifier"]
listing.write_text(json.dumps({"app": bundle, "binaries": sorted(binaries, key=lambda b: b["id"])}, indent=2))
PYEOF

        # Ad hoc: Device Farm signs the app again for its phones.
        codesign --force --sign - "$app"/Frameworks/*.dylib
        codesign --force --sign - "$app"
        (cd "$work" && zip -qry app.ipa Payload)
        mv "$work/app.ipa" "$out/"

        cp tools/device-farm/ios/run-tests.py "$package/"
        ;;
esac

# Stored, since the archives are compressed already.
python3 - "$package" "$out/tests.zip" << 'PYEOF'
import pathlib
import sys
import zipfile

root = pathlib.Path(sys.argv[1])
with zipfile.ZipFile(sys.argv[2], "w") as package:
    for path in sorted(root.rglob("*")):
        if path.is_file():
            package.write(path, path.relative_to(root))
PYEOF
ls -l "$out"
