#!/usr/bin/env bash
#MISE description="List the benchmark scenarios and the question each answers"
#USAGE arg "[args]..." var=#true help="Arguments to `mln-bench list`, such as `--filter` or `--json`"
set -euo pipefail
source tools/dev-shell.sh
eval "set -- ${usage_args:-}"
dev_shell cargo run -q --profile benchmark --config tools/bench/profile.toml -p mln-rs-bench -- list "$@"
