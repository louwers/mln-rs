  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f1faee"
      }
    },
    {
      "id": "low",
      "type": "org.maplibre.ngon",
      "source": "points",
      "filter": ["in", ["get", "kind"], ["literal", ["low", "alone"]]],
      "layout": {
        "ngon-allow-overlap": false,
        "ngon-ignore-placement": false
      },
      "paint": {
        "ngon-radius": 20,
        "ngon-corners": 6,
        "ngon-color": "#457b9d"
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "points",
      "filter": ["==", ["get", "kind"], "label"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Semibold", "Arial Unicode MS Bold"],
        "text-size": 16
      },
      "paint": {
        "text-color": "#1d3557"
      }
    },
    {
      "id": "high",
      "type": "org.maplibre.ngon",
      "source": "points",
      "filter": ["==", ["get", "kind"], "high"],
      "layout": {
        "ngon-allow-overlap": false,
        "ngon-ignore-placement": false
      },
      "paint": {
        "ngon-radius": 20,
        "ngon-corners": 5,
        "ngon-color": "#e63946"
      }
    }
  ]
