#!/usr/bin/env bash
#MISE description="Check crates/mln_c's browser package for one backend in headless Chromium"
#USAGE flag "--profile <profile>" default="dev" help="The Cargo profile, as for `web`"
#USAGE arg "[backend]" default="webgpu" help="webgpu, or gl (WebGL2)"
# Builds the package (`c-web`), loads it in headless Chromium and drives its
# raw C ABI from a Web Worker, as a JavaScript host does, until a map with a
# GeoJSON layer that the tile workers lay out shows on an OffscreenCanvas, for
# sessions one after another on devices of their own (crates/mln_c/web-check).
# Needs Node 24 and Playwright's Chromium (`npx playwright@1.61.1 install
# chromium`), as `web-check` does.
set -euo pipefail
mise run c-web --profile "$usage_profile" "$usage_backend"
node crates/mln_c/web-check/check.mjs "${CARGO_TARGET_DIR:-target}/c-web/$usage_backend" "$usage_backend"
