#!/usr/bin/env bash
#MISE description="Format the Rust code with the pinned nightly rustfmt"
# Generated files (their first lines say "Do not edit" or "@generated") stay as
# their generators write them: they are not passed to rustfmt, and their `mod`
# declarations carry #[rustfmt::skip], so formatting the module that declares
# them leaves them alone too. The patched copies of crates.io packages in
# patches/ keep their upstream's formatting.
set -euo pipefail
files=()
while IFS= read -r -d '' file; do
    head -n 5 "$file" | grep -q -e 'Do not edit' -e '@generated' || files+=("$file")
done < <(git ls-files -z '*.rs' ':!patches/')
if ! rustup component list --toolchain "$MLN_NIGHTLY" --installed 2> /dev/null | grep -q '^rustfmt'; then
    rustup toolchain install "$MLN_NIGHTLY" --profile minimal --component rustfmt --no-self-update
fi
rustfmt "+$MLN_NIGHTLY" --config imports_granularity=Module,group_imports=StdExternalCrate "$@" "${files[@]}"
