#!/usr/bin/env bash
#MISE description="Print which of CI's macos and web jobs a change needs, from its changed paths on stdin"
# CI's plan job runs this on a pull request's changed paths (`git diff
# --name-only main... | mise run ci:plan`); pushes to main run every job. A job
# is skipped when every changed path is one that it doesn't build or test.
set -euo pipefail
macos=false
web=false
while IFS= read -r path; do
    case $path in
        *.md) ;;
        crates/mln_d3d12/*) ;;
        crates/mln_mtl/* | examples/desktop/*) macos=true ;;
        crates/mln_vulkan/* | tools/c-abi-test/* | .github/actions/lavapipe/*) ;;
        crates/mln_web_host/* | crates/mln_web_shaper/* | examples/web/* | crates/mln_c/web-check/* | mise-tasks/web/* | mise-tasks/c-web/*) web=true ;;
        *) macos=true web=true ;;
    esac
done
echo "macos=$macos"
echo "web=$web"
