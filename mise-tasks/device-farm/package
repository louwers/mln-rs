#!/usr/bin/env bash
#MISE description="Build the Android tests into a test package for AWS Device Farm's phones (tools/device-farm)"
#USAGE flag "--out <file>" default="target/device-farm/android-tests.zip" help="Where to write the package"
# In the target-android environment: `mise -E target-android run
# device-farm:package`. tools/device-farm/README.md lists what the package
# holds.
set -euo pipefail
source tools/dev-shell.sh

if [[ -z ${CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER:-} ]]; then
    echo "Select the target-android environment: mise -E target-android run device-farm:package" >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
package=$work/package
mkdir -p "$package/bin"

packages=()
while IFS= read -r name; do
    packages+=(-p "$name")
done < <(tools/ci/target-packages.sh)
rustup target add aarch64-linux-android
dev_shell cargo nextest archive --target aarch64-linux-android "${packages[@]}" --archive-file "$package/tests.tar.zst"

# The test host, for the phones' ABI.
tools/android-test-host/build.sh arm64-v8a "$package/host"

git ls-files -z --cached --others --exclude-standard | tar --null --files-from - -czf "$package/workspace.tar.gz"

# The Linux x64 cargo-nextest and devices-cli pinned by mise, for Device Farm's
# Amazon Linux 2023 test host.
read -r nextest_url nextest_checksum devices_cli_version < <(
    python3 - << 'PYEOF'
import tomllib

with open("mise.lock", "rb") as f:
    nextest = tomllib.load(f)["tools"]["github:nextest-rs/nextest"][0]["platforms.linux-x64"]
with open("mise.target-android.toml", "rb") as f:
    devices_cli = tomllib.load(f)["tools"]["go:github.com/sargunv/devices-cli"]
print(nextest["url"], nextest["checksum"].removeprefix("sha256:"), devices_cli)
PYEOF
)
curl --fail --silent --show-error --location --output "$work/nextest.tar.gz" "$nextest_url"
echo "$nextest_checksum  $work/nextest.tar.gz" | shasum -a 256 --check --quiet
tar -xzf "$work/nextest.tar.gz" -C "$package/bin"

# Static Linux x64 binary so it runs on Amazon Linux 2023 regardless of the
# host OS or glibc version.
gomodcache=$(go env GOMODCACHE)
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOPATH="$work/go" GOMODCACHE="$gomodcache" GOBIN="" \
    go install -ldflags='-s -w' "github.com/sargunv/devices-cli@$devices_cli_version"
devices_cli_bin=$work/go/bin/linux_amd64/devices-cli
[[ -f $devices_cli_bin ]] || devices_cli_bin=$work/go/bin/devices-cli
cp "$devices_cli_bin" "$package/bin/devices-cli"

cp tools/device-farm/run-tests.sh "$package/"

mkdir -p "$(dirname "$usage_out")"
# Stored, since the archives are compressed already.
python3 - "$package" "$usage_out" << 'PYEOF'
import pathlib
import sys
import zipfile

root = pathlib.Path(sys.argv[1])
with zipfile.ZipFile(sys.argv[2], "w") as package:
    for path in sorted(root.rglob("*")):
        if path.is_file():
            package.write(path, path.relative_to(root))
PYEOF
ls -l "$usage_out"
