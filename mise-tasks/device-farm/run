#!/usr/bin/env bash
#MISE description="Run the Android tests on AWS Device Farm's phones with your AWS credentials (tools/device-farm)"
#USAGE flag "--package <file>" default="target/device-farm/android-tests.zip" help="The test package that device-farm:package built"
#USAGE flag "--results <dir>" default="target/device-farm/results" help="Where to download each phone's output and artifacts"
set -euo pipefail
exec tools/device-farm/schedule.sh "$usage_package" "$usage_results"
