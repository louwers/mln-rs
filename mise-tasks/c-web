#!/usr/bin/env bash
#MISE description="Build crates/mln_c's browser package for one backend (webgpu or gl) into target/c-web/<backend>"
#USAGE flag "--profile <profile>" default="dev" help="The Cargo profile, as for `web`"
#USAGE arg "[backend]" default="webgpu" help="webgpu, or gl (WebGL2)"
# maplibre-native-ffi's C ABI (crates/mln_c) as a browser package for a
# JavaScript host, one per backend, each with that backend only. Into
# target/c-web/<backend>: wasm-bindgen's bindings of the module
# (maplibre_native_c.js, whose instance's exports are the raw `mln_*` functions
# and its memory, beside the JavaScript contract in crates/mln_c/src/web.rs),
# the tile worker script and shaper loader under snippets/, and the font-face
# shaper module (mln_web_shaper.js).
set -euo pipefail
profile="$usage_profile"
backend="$usage_backend"
if [[ "$profile" == release ]]; then
    export CARGO_PROFILE_RELEASE_OPT_LEVEL=s
fi
target="${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/$([[ "$profile" == dev ]] && echo debug || echo "$profile")"
pkg="${CARGO_TARGET_DIR:-target}/c-web/$backend"
# The tile worker script imports the bindings beside it, so it stays a file (`--split-linked-modules`).
bind() {
    wasm-bindgen --target web --split-linked-modules --out-dir "$pkg" "$target/$1.wasm"
    if [[ "$profile" != dev ]]; then
        wasm-opt -Oz --converge --one-caller-inline-max-function-size=20 --zero-filled-memory --low-memory-unused \
            --strip-debug --strip-producers --strip-target-features "$pkg/$1_bg.wasm" -o "$pkg/$1_bg.wasm"
    fi
}
rm -rf "$pkg"
cargo build --profile "$profile" --target wasm32-unknown-unknown -p mln-rs-c -p mln-rs-web-shaper \
    --no-default-features --features "mln-rs-c/$backend"
bind maplibre_native_c
bind mln_web_shaper
