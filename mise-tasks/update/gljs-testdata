#!/usr/bin/env bash
#MISE description="Refresh the terrain and image render tests copied from MapLibre GL JS"
#USAGE arg "[checkout]" help="A maplibre-gl-js checkout (default ../maplibre-gl-js)"
#USAGE flag "--commit <sha>" help="The checkout's commit, if it isn't a git checkout"
# Copies the render tests that exercise terrain and the fog that sits on it,
# and image sources, which GL JS warps as mln-rs does where MapLibre Native's
# own tests expect two affine triangles, with their expected images, from
# test/integration/render/tests, and the tile,
# image and GeoJSON files they load from test/integration/assets, to
# tools/render-test/testdata/metrics/integration/gljs. That directory is
# mln-rs's own: `mise run update:testdata` leaves it alone, and this task
# rewrites it whole. Fixtures that GL JS adds to the selection come along; add
# those that don't pass to an ignore file in tools/render-test/ignores.
#
# GL JS's tests allow a difference of 0.00025 unless they say otherwise,
# where the runner's default is stricter, so the copy of a test that sets no
# `allowed` sets GL JS's, and the copy of a test in `allowed` below sets its
# own. That and the formatting are the only changes to a style.json.
#
# Glyphs and sprites aren't copied: the cache the runner reads already has
# the ones these tests use (tools/render-test/testdata/metrics/cache-style.db).
set -euo pipefail

# Tests that draw as GL JS's but differ by more than they allow, and why. The
# numbers are the pixels that differ, measured with WebGPU, Vulkan and OpenGL
# alike unless they say which: on RADV, on CI's Mesa 26.0.8 (lavapipe, and
# llvmpipe for OpenGL), and on Mesa 26.2.5's llvmpipe.
#
# The terrain samples its drapes with mips and anisotropy, and how a device
# picks the level of detail of an anisotropic sample isn't specified. Mesa
# 26.0.8's llvmpipe takes the lengths of the texture coordinates' screen
# derivatives as the footprint's axes; Mesa 26.2.5's first finds the
# footprint's ellipse (`GALLIVM_PERF=no_lod_ellipse` brings back 26.0.8's
# numbers), which picks sharper levels. The drape's edges then look softer or
# sharper than GL JS's, and its far texels move. No anisotropy changes that:
# 26.0.8 gives the same numbers from 2 to 16.
declare -A allowed=(
    # 7 of 65536 on RADV, 27 on Mesa 26.0.8, 12 on Mesa 26.2.5. Heights read a
    # texel off: 1785 (RADV), 1881 (lavapipe). Anisotropy 1: 247 (RADV), 141
    # (lavapipe).
    [terrain/default]=0.0005
    # 43 of 262144 on RADV; on Mesa 26.0.8, 189 (lavapipe) and 165 (llvmpipe);
    # on Mesa 26.2.5, 52 (lavapipe) and 42 (llvmpipe). With skirts: 14467
    # (RADV), 14506 (lavapipe), 14479 (llvmpipe). Anisotropy 1: 1037 (RADV),
    # 697 (lavapipe), 686 (llvmpipe). Fill outlines 2 px wide in the drape:
    # 75 (RADV) and 189 (lavapipe), which pass, and 227 (llvmpipe).
    [terrain/skirts-none]=0.0008
    # 40 of 262144 on RADV; on Mesa 26.0.8, 185 (lavapipe) and 165 (llvmpipe);
    # on Mesa 26.2.5, 50 (lavapipe) and 41 (llvmpipe). Without skirts: 14551
    # (RADV), 14546 (lavapipe), 14524 (llvmpipe). Anisotropy 1: 1089 (RADV),
    # 790 (lavapipe), 778 (llvmpipe).
    [terrain/skirts-auto]=0.0008
    # The moiré's texels move: 279 of 65536 (0.43%) on RADV, 170 (0.26%) on
    # Mesa 26.0.8, 1051 (lavapipe) and 1046 (llvmpipe) (1.6%) on Mesa 26.2.5.
    # Without the drape's mips: 6451 (RADV), 6408 (lavapipe 26.0.8) and 6409
    # (Mesa 26.0.8's llvmpipe, Mesa 26.2.5's lavapipe and llvmpipe), 9.8%.
    [terrain/rtt-mipmap-minification/pitch-70]=0.02
    # Drawn better than GL JS's image, which shows a gap under the downhill
    # walls: their feet stop 10 m below the ground at the polygon's centroid.
    # Here a ground-level wall's foot reaches the ground under its own end,
    # so 165 of 262144 px differ on RADV, all along the feet of two
    # buildings' south walls on the slope; 174 (lavapipe) and 172 (llvmpipe)
    # on Mesa 26.0.8, 164 on Mesa 26.2.5. Walls not depth-tested against the
    # ground: 590 (RADV). Buildings at sea level: 3590 (RADV), and 6875 drawn
    # flat, as before they stood on the ground.
    [terrain/fill-extrusion]=0.0008
    # The labels hide behind the ridges as GL JS's do; 51 of 262144 px differ
    # on RADV (WebGPU and Vulkan), 50 (OpenGL), 83 on Mesa 26.0.8's lavapipe
    # and 59 on Mesa 26.2.5's llvmpipe, single pixels along the drapes'
    # silhouettes. With nothing hidden: 2446 (RADV).
    [terrain/occlusion-debug]=0.0004
    # GL JS colors each tile's kernel density on its own over terrain and
    # blends the tiles, where mln-rs sums density across tiles, as both do
    # without terrain: 1552 of 262144 px differ on RADV (WebGPU and Vulkan),
    # 1568 (OpenGL), 1587 on Mesa 26.0.8's lavapipe and 1593 on Mesa 26.2.5's
    # llvmpipe, all in the two patches where kernels of the fixture's two
    # GeoJSON tiles overlap. Kernels hidden behind the ground: 29095 (RADV).
    # Kernels at sea level: 62776 (RADV).
    [terrain/heatmap]=0.007
    # GL JS draws a terrain's DEM source at twice its declared tile size,
    # which this fixture's hillshade shares, so its far hills shade from DEM
    # tiles a zoom coarser; mln-rs keeps the declared size. 210 of 262144 px
    # differ on RADV (WebGPU), single pixels and short runs on the far hills;
    # 58, which pass, with the hillshade on a copy of the source declared
    # 512 px. The label hidden or missing: 1160 (RADV). Seams where DEM tiles
    # of two overscaled zooms meet: 481 (RADV).
    [terrain/symbol-height-offset-occluded-ground]=0.0012
    # Terrain on the globe. The numbers here are WebGPU's, on RADV and on Mesa
    # 26.0.8's lavapipe; "flat" is the same fixture before terrain drew on the
    # globe, which drew the layers on the sphere without drapes.
    #
    # The planet's limb is the chords of the surface's grid, where GL JS's
    # drawn the same way differs by single pixels: 126 of 262144 on RADV and
    # 128 on lavapipe (flat: 171 on both).
    [projection/globe/terrain/atmosphere/base]=0.0006
    # As atmosphere/base: 147 (RADV), 148 (lavapipe); flat: 142, 143.
    [projection/globe/terrain/atmosphere/light-position-map]=0.0006
    # As atmosphere/base: 164 (RADV), 165 (lavapipe); flat: 139.
    [projection/globe/terrain/atmosphere/ligth-position-viewport]=0.0007
    # Past the handover, on Mercator: the far ridges at pitch 80. 44 of 65536
    # (RADV), 48 (lavapipe), as on Mercator with no projection set.
    [terrain/fog-sky-blend-globe]=0.0008
    # The drapes' edges, sampled with mips and anisotropy, where the globe
    # turns away (see above). The lines are as wide as GL JS's, where flat
    # they were wider: 115 of 262144 (RADV), 320 (lavapipe); flat: 65 (RADV),
    # 25 (lavapipe).
    [projection/globe/terrain/line-spiral]=0.0013
    # The drapes' edges: 32 (RADV), 141 (lavapipe); flat: 0, 2.
    [projection/globe/terrain/line-translate]=0.0006
    # The drapes' edges: 29 (RADV), 68 (lavapipe); flat: 163, 111.
    [projection/globe/terrain/fill-planet-pitched]=0.0003
    # The drapes' edges: 52 (RADV), 259 (lavapipe); flat: 1400, 1573.
    [projection/globe/terrain/fill-planet-pole]=0.0011
    # The drapes' edges: 32 (RADV), 72 (lavapipe); flat: 569, 547.
    [projection/globe/terrain/fill-planet-tiles]=0.0003
    # The drapes' edges: 34 (RADV), 79 (lavapipe); flat: 578, 561.
    [projection/globe/terrain/fill-planet-tiles-no-background]=0.0004
    # The drapes' edges: 56 (RADV), 97 (lavapipe); flat: 191, 192.
    [projection/globe/terrain/line-gradient]=0.0004
    # Each circle draws once, from the tile that holds it, as in GL JS. The
    # circles near the limb sit up to a pixel from GL JS's, as they do in GL
    # JS's projection/globe twin without terrain drawn here with each circle
    # once (911 px; the image is the same to 3 px): 914 of 65536 (RADV), 923
    # (lavapipe). On the sea-level sphere, each drawn once for every tile
    # buffer that holds it: 9550.
    [projection/globe/terrain/circle-planet]=0.0141
    # As circle-planet: the far circles a pixel from GL JS's, 134 (RADV), 149
    # (lavapipe); the twin drawn once each, 134. On the sea-level sphere:
    # 9731.
    [projection/globe/terrain/circle-pitch-alignment/map-scale-map]=0.0023
    # As circle-planet: 236 (RADV), 235 (lavapipe); the twin drawn once
    # each, 236. On the sea-level sphere: 7477.
    [projection/globe/terrain/circle-pitch-alignment/map-scale-viewport]=0.0037
    # Its labels don't drape and draw as without terrain: 8 of 65536 (RADV),
    # 20 on lavapipe, flat too.
    [projection/globe/terrain/collision-icon-text-translate-map]=0.0004
)

checkout="${usage_checkout:-$PWD/../maplibre-gl-js}"
integration="$checkout/test/integration"
dest=tools/render-test/testdata/metrics/integration/gljs

commit="${usage_commit:-}"
if [[ -z $commit ]]; then
    commit="$(git -C "$checkout" rev-parse HEAD)" || {
        echo "$checkout isn't a git checkout: pass its commit with --commit" >&2
        exit 1
    }
fi

# The selection leaves out GL JS's custom layers, which are JavaScript of its
# own harness that the runner doesn't have: custom-layer-js, and the globe's
# projection/globe/terrain/custom, the one subdirectory there to start "cu".
selected='^(terrain/.*|projection/globe/terrain/([^c]|c[^u]).*|image/.*|regressions/mapbox-gl-js#3010|sky/fog-.*|terrain-shading/default|high-pitch/terrain-pitch95|(fill-layer-blend|fill-layer-opacity|line-layer-blend|line-layer-opacity|line-opacity|raster-layer-blend)/terrain)$'

rm -rf "$dest"
mkdir -p "$dest/render-tests" "$dest/assets"
assets="$(mktemp)"
trap 'rm -f "$assets"' EXIT

while IFS= read -r -d '' style; do
    id="$(dirname "${style#"$integration/render/tests/"}")"
    if [[ ! $id =~ $selected ]]; then
        continue
    fi
    mkdir -p "$dest/render-tests/$id"
    cp "$(dirname "$style")"/expected*.png "$dest/render-tests/$id/"
    jq --indent 2 --argjson allowed "${allowed[$id]:-null}" \
        '.metadata.test.allowed = ($allowed // .metadata.test.allowed // 0.00025)' \
        "$style" >"$dest/render-tests/$id/style.json"
    jq -r '.. | strings | select(startswith("local://")) | ltrimstr("local://")' "$style" >>"$assets"
done < <(find "$integration/render/tests" -name style.json -print0 | sort -z)

for id in "${!allowed[@]}"; do
    if [[ ! -f $dest/render-tests/$id/style.json ]]; then
        echo "allowed names $id, which isn't copied" >&2
        exit 1
    fi
done

# Each local:// URL names a file, or a template of tiles: every file that
# fits it is copied.
sort -u "$assets" | while IFS= read -r url; do
    case $url in glyphs/* | sprites/*) continue ;; esac
    pattern="$(sed -e 's/[.]/\\./g' -e 's/{[zxy]}/[0-9]+/g' <<<"$url")"
    files="$(cd "$integration/assets" && find . -type f | sed 's|^\./||' | grep -E "^$pattern$" || true)"
    if [[ -z $files ]]; then
        echo "no asset for local://$url" >&2
        exit 1
    fi
    printf '%s\n' "$files"
done | sort -u | rsync -a --files-from=- "$integration/assets"/ "$dest/assets"/

cp "$checkout/LICENSE.txt" "$dest/"
cat >"$dest/README.md" <<EOF
Render tests copied from MapLibre GL JS at commit $commit, with the assets they
load, by \`mise run update:gljs-testdata\`. Don't edit them here.
EOF
echo "copied from $checkout ($commit): $(find "$dest/render-tests" -name style.json | wc -l) tests, $(find "$dest/assets" -type f | wc -l) assets"
