#!/usr/bin/env bash
#MISE description="Run maplibre-native-ffi's ABI tests against the C library"
#USAGE arg "[args]..." var=#true help="Arguments to tools/c-abi-test/run.py, such as `--jobs`"
# Configures and builds tools/c-abi-test in target/c-abi-test-<backend>,
# against crates/mln_c's shared library, then runs it with
# tools/c-abi-test/run.py. It fails when any case fails or any exit program
# doesn't exit cleanly. The backend is MLN_C_TEST_BACKEND's: vulkan by
# default, or opengl, on EGL, which runs on llvmpipe as CI does with
# LIBGL_ALWAYS_SOFTWARE=1. Needs CMake, a C23 and C++23 compiler, the Vulkan
# headers and loader, a Vulkan driver such as lavapipe (VK_DRIVER_FILES),
# libwayland-server and libwayland-client, which the Wayland cases load, and
# for opengl the EGL and OpenGL ES headers and libraries.
set -euo pipefail
source tools/dev-shell.sh
eval "set -- ${usage_args:-}"
target="${CARGO_TARGET_DIR:-target}"
[[ $target == /* ]] || target="$PWD/$target"
backend="${MLN_C_TEST_BACKEND:-vulkan}"
build="$target/c-abi-test-$backend"
dev_shell cargo build -p mln-rs-c
# Built alone, as hosts build it, the library still shapes font faces.
cargo tree -p mln-rs-c -e features --prefix none | grep -q '^mln-rs-renderer feature "font-face-shaper"'
dev_shell cmake -S tools/c-abi-test -B "$build" -DMLN_C_LIBRARY="$target/debug/libmaplibre_native_c.so" -DMLN_C_TEST_BACKEND="$backend"
dev_shell cmake --build "$build" --parallel
dev_shell python3 -I tools/c-abi-test/run.py "$build/mln_native_abi_tests" --exit-programs "$build/exit" "$@"
