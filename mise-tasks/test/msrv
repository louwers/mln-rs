#!/usr/bin/env bash
#MISE description="Check that the workspace builds with its minimum supported Rust"
set -euo pipefail
msrv="$(cargo metadata --no-deps --format-version 1 | jq -r '.packages[] | select(.name == "mln-rs") | .rust_version')"
rustup toolchain install "$msrv" --profile minimal --no-self-update
cargo "+$msrv" check --workspace --all-targets
