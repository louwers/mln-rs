#!/usr/bin/env bash
#MISE description="Measure the coverage of the tests (`mise run test`) from a clean start, then report it: by default, open the HTML report"
#USAGE arg "[args]..." var=#true help="Arguments to `cargo llvm-cov report` (default `--open`)"
set -euo pipefail
source tools/dev-shell.sh
eval "set -- ${usage_args:-}"
[[ $# -gt 0 ]] || set -- --open
cargo llvm-cov clean --workspace
dev_shell cargo llvm-cov nextest --no-report --workspace
cargo llvm-cov report --workspace "$@"
