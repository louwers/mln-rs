#!/usr/bin/env bash
#MISE description="Compare the benchmarks of this checkout, uncommitted changes included, with another commit (tools/bench/README.md)"
#USAGE arg "[base]" default="main" help="The Git ref to compare with"
#USAGE arg "[args]..." var=#true help="Arguments to `mln-bench compare`, such as `--filter` or `--rounds`"
set -euo pipefail
source tools/dev-shell.sh
eval "set -- ${usage_args:-}"
dev_shell cargo run -q --profile benchmark --config tools/bench/profile.toml -p mln-rs-bench -- compare "$usage_base" "$@"
