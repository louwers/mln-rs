#!/usr/bin/env bash
#MISE description="Lint the browser build, and check it pulls in no native-only dependencies"
# The browser build (wasm32-unknown-unknown, no atomics: one wasm instance per
# Web Worker, each with its own memory) needs the target, which
# rust-toolchain.toml installs. Clippy, so that examples/web, which only builds
# there, is linted too. Three runs, since one would unify their features: the
# libraries as published (mln_storage's `sqlite` feature on, its SQLite built
# through sqlite-wasm-rs, which needs a clang that targets wasm32, and the
# in-process font-face shaper), the browser build's two modules as `mise run
# web:build` builds them, which leave both out, with mln_web_host, the glue they
# share, and the map's module with its `webgl` feature. The check fails if
# anything turns SQLite back on in the browser build, or brings in a C build
# (`cc`) that would need that clang, or if the module that draws with WebGPU
# gets the OpenGL backend (mln_gl and its GL bindings), which only the `webgl`
# module needs, or if the browser build brings in ICU4X: it takes its locale
# services from the browser's `Intl`. Then the C library (crates/mln_c, with
# mln_runtime) as its browser package builds it, once per backend, with the
# same checks on what it brings in, and neither backend's package may carry
# the other's.
set -euo pipefail
source tools/dev-shell.sh

# `lacks <pattern> <cargo tree arguments>...` fails when the dependency tree
# for wasm32-unknown-unknown has a package whose line matches the pattern.
lacks() {
    local pattern="$1"
    shift
    if cargo tree --target wasm32-unknown-unknown --prefix none "$@" | grep -Eq "$pattern"; then
        echo "error: \`cargo tree $*\` has a package matching '$pattern'" >&2
        exit 1
    fi
}

dev_shell cargo clippy --target wasm32-unknown-unknown -p mln-rs
cargo clippy --target wasm32-unknown-unknown -p mln-rs-web -p mln-rs-web-shaper -p mln-rs-web-host
cargo clippy --target wasm32-unknown-unknown -p mln-rs-web --features webgl
lacks '^rusqlite ' -p mln-rs-web --edges normal
lacks '^cc ' -p mln-rs-web --edges normal,build
lacks '^(mln-rs-gl|glow) ' -p mln-rs-web --edges normal
lacks '^icu_' -p mln-rs-web --edges normal
for backend in webgpu gl; do
    cargo clippy --target wasm32-unknown-unknown -p mln-rs-c --no-default-features --features "$backend"
    lacks '^(rusqlite|icu_) ' -p mln-rs-c --no-default-features --features "$backend" --edges normal
    lacks '^cc ' -p mln-rs-c --no-default-features --features "$backend" --edges normal,build
done
lacks '^(mln-rs-gl|glow) ' -p mln-rs-c --no-default-features --features webgpu --edges normal
lacks '^(mln-rs-webgpu|wgpu) ' -p mln-rs-c --no-default-features --features gl --edges normal
