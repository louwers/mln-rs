{
  "version": 8,
  "metadata": {
    "test": {
      "height": 64,
      "width": 64,
      "description": "Feature state sets each point's radius, as heatmap-radius/data-expression's properties do. Contains two expected images (for ubyte-based rendering and half-float-based); one of them should pass depending on platform.",
      "operations": [
        [
          "setFeatureState",
          {
            "source": "geojson",
            "id": "1"
          },
          {
            "radius": 5
          }
        ],
        [
          "setFeatureState",
          {
            "source": "geojson",
            "id": "2"
          },
          {
            "radius": 10
          }
        ],
        [
          "wait"
        ]
      ]
    }
  },
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {},
            "geometry": {
              "type": "Point",
              "coordinates": [
                -10,
                0
              ]
            },
            "id": "1"
          },
          {
            "type": "Feature",
            "properties": {},
            "geometry": {
              "type": "Point",
              "coordinates": [
                10,
                0
              ]
            },
            "id": "2"
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "heatmap",
      "type": "heatmap",
      "source": "geojson",
      "paint": {
        "heatmap-radius": [
          "coalesce",
          [
            "feature-state",
            "radius"
          ],
          30
        ]
      }
    }
  ]
}
